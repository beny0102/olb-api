# Demo placeholders for the local compose package.
#
#   cp deploy/.env.example deploy/.env
#
# These values are not secrets. Replace every password before exposing the
# stack outside localhost; deploy/.env is ignored by git.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=olb
POSTGRES_DB=olb
POSTGRES_PORT=55451

API_PORT=3201
WEB_PORT=3200
SCORER_PORT=3202

CORS_ORIGIN=http://localhost:3200,http://localhost:3202

# Baked into the browser bundles at build time.
NEXT_PUBLIC_API_URL=http://localhost:3201
NEXT_PUBLIC_VIEWER_URL=http://localhost:3200

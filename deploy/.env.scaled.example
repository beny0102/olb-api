# Scaled deployment placeholders.
#
#   cp deploy/.env.scaled.example deploy/.env
#   docker compose -f deploy/docker-compose.scaled.yml up -d --build --scale api=2
#
# These values are not secrets. Replace every password before exposing the
# stack outside localhost; deploy/.env is ignored by git.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=olb
POSTGRES_DB=olb

# Address users open in the browser. Used for CORS and the baked client API URL.
PUBLIC_ORIGIN=http://localhost:8080

# The only published host port.
GATEWAY_PORT=8080

# Shared first-run setup token for both API replicas. Replace it before any
# deployment that is not local.
SETUP_TOKEN=olb-scaled-setup-token-change-me
